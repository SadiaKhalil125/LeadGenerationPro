# Filename: Dockerfile.hf
FROM python:3.11-slim

# Set up a new user with UID 1000
RUN useradd -m -u 1000 user
WORKDIR /app

# Install system dependencies for Playwright
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade -r requirements.txt

# Install Playwright and its browser dependencies
# We do this as root first to install system-level deps
RUN playwright install-deps chromium
RUN playwright install chromium

# Give ownership of the app directory to our user
COPY --chown=user . .

# Switch to the non-root user
USER user

# Set environment variables for Playwright to find browsers
ENV PLAYWRIGHT_BROWSERS_PATH=/home/user/.cache/ms-playwright

# Expose the HF Spaces port
EXPOSE 7860

# Run the worker (which now includes the health check server)
CMD ["python", "worker.py"]
